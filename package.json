{
  "name": "scan-repair-local",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:site",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "build:site": "npm run prepare:ocr && vite build --outDir dist/site",
    "tauri": "tauri",
    "test": "vitest run",
    "test:claims": "playwright test",
    "test:browser": "playwright test",
    "lint": "tsc --noEmit",
    "test:watch": "vitest",
    "preview": "vite preview --outDir dist/site",
    "postinstall": "npm run prepare:ocr"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "jspdf": "4.2.1",
    "pdfjs-dist": "6.2.108",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "axe-core": "^4.10.3",
    "jsdom": "^30.0.1",
    "playwright": "^1.58.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
